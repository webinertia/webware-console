{
    "name": "webware/webware-console",
    "description": "Webware Console — TUI application providing a menu and better help for Webware and Mezzio CLI commands",
    "license": "BSD-3-Clause",
    "bin": [
        "bin/webware"
    ],
    "keywords": [
        "webware",
        "console",
        "tui",
        "mezzio",
        "cli"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "require": {
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-servicemanager": "^4.5",
        "php": "~8.4.1 || ~8.5.0",
        "php-standard-library/terminal": "^6.2",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpunit/phpunit": "^13.3",
        "webware/webware-tools": "^0.1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webware\\Console\\Test\\Integration\\": "test/integration/",
            "Webware\\Console\\Test\\Unit\\": "test/unit/"
        }
    },
    "scripts": {
        "console": "php bin/webware",
        "console-menu": "php bin/webware menu",
        "menu": "php bin/webware menu",
        "mutation-test": "infection",
        "test": "phpunit --testsuite unit",
        "test-coverage": "phpunit --coverage-clover clover.xml",
        "test-all": [
            "@test",
            "@test-integration"
        ],
        "test-integration": "phpunit --testsuite integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.4.99"
        }
    }
}
